{% extends 'admin.twig' %}

{% set title %}{{ 'TrackingSpamRules_PageTitle'|translate }}{% endset %}

{% block content %}
<div id="tsr" class="tsr">
    <script type="application/json" id="tsr-data">{{ tsrData|raw }}</script>

    <header class="tsr-head">
        <div>
            <h1 class="tsr-title">{{ 'TrackingSpamRules_PageTitle'|translate }}</h1>
            <p class="tsr-intro">{{ 'TrackingSpamRules_Intro'|translate }}</p>
        </div>
        <div class="tsr-health" id="tsr-health"></div>
    </header>

    <div class="tsr-bar">
        <div class="tsr-tabs" role="tablist">
            <button type="button" role="tab" class="tsr-tab" data-tab="overview" aria-selected="true">{{ 'TrackingSpamRules_TabOverview'|translate }}</button>
            <button type="button" role="tab" class="tsr-tab" data-tab="rules" aria-selected="false">{{ 'TrackingSpamRules_TabRules'|translate }} <span class="tsr-count" id="tsr-rules-count"></span></button>
            <button type="button" role="tab" class="tsr-tab" data-tab="sessions" aria-selected="false">{{ 'TrackingSpamRules_TabSessions'|translate }}</button>
        </div>
        <div class="tsr-scope">
            <div class="tsr-seg" id="tsr-days" role="group" aria-label="{{ 'TrackingSpamRules_Days'|translate('') }}">
                <button type="button" data-days="7">{{ 'TrackingSpamRules_Days'|translate(7) }}</button>
                <button type="button" data-days="30" class="is-on">{{ 'TrackingSpamRules_Days'|translate(30) }}</button>
                <button type="button" data-days="90">{{ 'TrackingSpamRules_Days'|translate(90) }}</button>
            </div>
            <select id="tsr-site" class="browser-default tsr-select" aria-label="{{ 'TrackingSpamRules_Site'|translate }}"></select>
        </div>
    </div>

    <section class="tsr-panel" data-panel="overview">
        <div class="tsr-tiles" id="tsr-tiles"></div>
        <div class="tsr-card">
            <div class="tsr-card-head">
                <h2>{{ 'TrackingSpamRules_ChartTitle'|translate }}</h2>
                <div class="tsr-legend">
                    <span><i class="tsr-dot tsr-c-block"></i>{{ 'TrackingSpamRules_LegendBlocked'|translate }}</span>
                    <span><i class="tsr-dot tsr-c-observe"></i>{{ 'TrackingSpamRules_LegendObserved'|translate }}</span>
                    <span><i class="tsr-dot tsr-c-official"></i>{{ 'TrackingSpamRules_LegendOfficial'|translate }}</span>
                </div>
            </div>
            <div class="tsr-chart" id="tsr-chart"></div>
        </div>
        <div class="tsr-card">
            <div class="tsr-card-head"><h2>{{ 'TrackingSpamRules_BreakdownTitle'|translate }}</h2></div>
            <div id="tsr-breakdown"></div>
        </div>
    </section>

    <section class="tsr-panel" data-panel="rules" hidden>
        <div class="tsr-panel-head">
            <p class="tsr-muted">{{ 'TrackingSpamRules_FormConditionsHelp'|translate }}</p>
            <button type="button" class="tsr-btn tsr-btn-primary" id="tsr-new">+ {{ 'TrackingSpamRules_NewRule'|translate }}</button>
        </div>
        <div id="tsr-rules"></div>
    </section>

    <section class="tsr-panel" data-panel="sessions" hidden>
        <div class="tsr-panel-head">
            <div class="tsr-chips" id="tsr-source" role="group">
                <button type="button" class="is-on" data-source="">{{ 'TrackingSpamRules_FilterAll'|translate }}</button>
                <button type="button" data-source="rule">{{ 'TrackingSpamRules_FilterRules'|translate }}</button>
                <button type="button" data-source="official">{{ 'TrackingSpamRules_FilterOfficial'|translate }}</button>
                <button type="button" data-source="flagged">{{ 'TrackingSpamRules_FilterFlagged'|translate }}</button>
            </div>
            <select id="tsr-rule-filter" class="browser-default tsr-select" aria-label="{{ 'TrackingSpamRules_TabRules'|translate }}"></select>
        </div>
        <p class="tsr-muted">{{ 'TrackingSpamRules_SessionsHelp'|translate }}</p>
        <div id="tsr-notice"></div>
        <div class="tsr-card tsr-card-flush"><div id="tsr-journal"></div></div>
        <p class="tsr-center"><button type="button" class="tsr-btn" id="tsr-more" hidden>{{ 'TrackingSpamRules_More'|translate }}</button></p>
    </section>

    <div class="tsr-overlay" id="tsr-overlay" hidden></div>
    <aside class="tsr-drawer" id="tsr-drawer" hidden aria-modal="true" role="dialog" aria-labelledby="tsr-drawer-title"></aside>
    <div class="tsr-modal" id="tsr-modal" hidden role="alertdialog" aria-modal="true"></div>
    <div class="tsr-toast" id="tsr-toast" hidden role="status"></div>
</div>
{% endblock %}
